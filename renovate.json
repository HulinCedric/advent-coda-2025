{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 6am on monday"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Automerge non-major updates once CI is green",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group Spectre.Console packages",
      "matchPackageNames": [
        "Spectre.Console**"
      ],
      "groupName": "Spectre.Console"
    },
    {
      "description": "Group day 15 npm tooling",
      "matchManagers": [
        "npm"
      ],
      "groupName": "day 15 npm tooling"
    }
  ]
}